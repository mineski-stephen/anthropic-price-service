# Copy this file to .env (same folder) and fill in the key. .env is git-ignored: never commit it.

# Required: an Anthropic API key (console.anthropic.com > API keys). Web search must be enabled
# for the organisation (Console > Settings > Capabilities).
ANTHROPIC_API_KEY=

# The Lark login check. The page logs in with Lark, so it can stay on here too; then searches are
# saved to the real saved searches table, as you. Off, nothing is saved, and server.js refuses to
# listen anywhere but 127.0.0.1.
REQUIRE_LARK_LOGIN=true

# The page allowed to call the service.
ALLOWED_ORIGINS=http://127.0.0.1:9128

# One run's spending limit in US dollars (it's asked to wrap up at 70%).
MAX_RUN_USD=2

# Optional
# PORT=8003
# SEARCHES_TABLE_ID=tblYUSBGnqwDp0PN   # the saved searches table (in LARK_BASE_TOKEN's Base unless SEARCHES_BASE_TOKEN is set)
# MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# DEFAULT_MODEL=claude-opus-5-5
# RATE_LIMIT_PER_HOUR=10
# READ_RATE_LIMIT_PER_HOUR=600
# MAX_CONCURRENT=2
# TZ_OFFSET_HOURS=8
# RECORD_RUNS=1        # keep each run's raw answer in runs/ (git-ignored), for checking shapes
